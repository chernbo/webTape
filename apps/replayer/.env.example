# docker compose variables
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=fed_bugtape
MYSQL_USER=webtape
MYSQL_PASSWORD=webtape

# Prisma / 应用连接串

# 本地开发 (compose.yaml 只起 MySQL, 应用在宿主机跑) 用下面这条:
# mysql://用户名:密码@主机:端口/数据库名[?参数键值对]
DATABASE_URL="mysql://webtape:webtape@localhost:3306/fed_bugtape"
# 注: docker compose 全栈 (docker-compose.yml) 会自动组装 DATABASE_URL, 无需在此手填

# public URL used when the API returns replay links
REPLAYER_PUBLIC_URL=http://localhost:3100

# CORS: SDK 从业务页面跨域上传, 自建服务(无网关)必须开启, 否则浏览器拦截上传。
#   不填    → 非生产默认放开 '*'; 生产不注入 (交给网关/反代处理)
#   *       → 允许所有来源 (自建最省事)
#   逗号分隔 → 白名单, 如 https://a.example.com,https://b.example.com
# 自建部署建议设为 * 或你的业务域名白名单。
CORS_ALLOW_ORIGIN=*

# ─── AI 分析 (可选) ───────────────────────────────────────────────
# AI 分析走服务端代理 /api/ai/analyze, Key 只在服务端使用, 不会泄露到浏览器.
# ⚠️ 严禁改成 NEXT_PUBLIC_ 前缀 —— 那样会把 Key 打进前端 bundle.
# 不配置这两项时, "AI 分析" 按钮会返回 "未配置" 提示, 不影响其它功能.
AI_WORKFLOW_API_URL="https://your-ai-workflow-api.example.com/v1/workflows/run"
AI_WORKFLOW_API_KEY="your-workflow-api-key"
